Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^r/([A-Za-z0-9]{3,16})/?$ referidos/redir.php?c=$1 [L,QSA]
    RewriteRule ^panel/?$                  referidos/panel.php    [L,QSA]
    RewriteRule ^verificando/?$            /verificando.php        [L,QSA]
    RewriteRule ^login/?$                  index.php              [L,QSA]
</IfModule>

<FilesMatch "\.(php|html)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </IfModule>
</FilesMatch>